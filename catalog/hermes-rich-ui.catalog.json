{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/a2ui/hermes-rich-ui/1/catalog.json",
  "protocolVersion": "1.0",
  "catalogId": "hermes-rich-ui/1",
  "title": "Hermes Rich UI catalog",
  "description": "Read-only A2UI v1.0 catalog for hermes-rich-ui cards: 18 presentation components, zero functions. Single source of truth for admission (engine/admission.py) and the desktop renderer.",
  "instructions": "hermes-rich-ui/1 is a READ-ONLY presentation catalog: 18 component types, no functions, no actions, no inputs. Compose ONE tree: exactly one component has id \"root\" (normally a Card). Containers (Card/Stack/Grid) reference children by id; Tabs/Accordion reference one child per tab/item; every other type is a leaf. Each id is used by exactly one parent; no cycles, no unreachable components. Bind values with {\"path\": \"/data/...\"} or {\"path\": \"/meta/...\"} (RFC 6901); every path must resolve. null means UNKNOWN and renders as unavailable — never write 0 for a missing number. Never invent series, rows, bins or history: chart/table data must come from the supplied data or a declared derivation. Cite: put sourceIds on claims and rows, end with a SourceList; state method and caveat in derivations. Budgets: <=64 components, depth <=8, series <=4x512 points, tables <=100x12, timeline <=30, key/value <=32, strings <=4 KiB. Admission rejects (never truncates) anything outside this catalog.",
  "components": {
    "Card": {
      "type": "object",
      "description": "Container with an optional title/subtitle; the usual root. Expands beyond the initial 480 px cap on user click.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Card"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "subtitle": {
          "$ref": "#/$defs/DynamicString"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "minItems": 1,
          "maxItems": 32,
          "description": "Ordered child component ids (1..32). Each id may be used by exactly one parent."
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "Stack": {
      "type": "object",
      "description": "Linear layout container.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Stack"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "direction": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical"
        },
        "gap": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md",
          "description": "Spacing between children."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "minItems": 1,
          "maxItems": 32,
          "description": "Ordered child component ids (1..32). Each id may be used by exactly one parent."
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "Grid": {
      "type": "object",
      "description": "Column grid container (1..4 columns).",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Grid"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "gap": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md",
          "description": "Spacing between children."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "minItems": 1,
          "maxItems": 32,
          "description": "Ordered child component ids (1..32). Each id may be used by exactly one parent."
        }
      },
      "required": [
        "id",
        "component",
        "columns",
        "children"
      ],
      "additionalProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "Horizontal rule with an optional label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Divider"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "component"
      ],
      "additionalProperties": false
    },
    "Tabs": {
      "type": "object",
      "description": "Tabbed container; each tab shows exactly one child component.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Tabs"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/$defs/DynamicString"
              },
              "child": {
                "$ref": "#/$defs/ComponentId"
              }
            },
            "required": [
              "title",
              "child"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "component",
        "tabs"
      ],
      "additionalProperties": false
    },
    "Accordion": {
      "type": "object",
      "description": "Collapsible sections; each item shows exactly one child component.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Accordion"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "#/$defs/DynamicString"
              },
              "child": {
                "$ref": "#/$defs/ComponentId"
              },
              "open": {
                "type": "boolean"
              }
            },
            "required": [
              "title",
              "child"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "component",
        "items"
      ],
      "additionalProperties": false
    },
    "Heading": {
      "type": "object",
      "description": "Section heading.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Heading"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "level": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ],
          "default": 2
        }
      },
      "required": [
        "id",
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "description": "Plain text paragraph. Newlines are kept; no markdown, no HTML.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Text"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "tone": {
          "type": "string",
          "enum": [
            "default",
            "muted"
          ],
          "default": "default"
        },
        "variant": {
          "type": "string",
          "enum": [
            "body",
            "caption"
          ],
          "default": "body"
        }
      },
      "required": [
        "id",
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "Callout": {
      "type": "object",
      "description": "Emphasised note (takeaway, caveat, confirmation).",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Callout"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "title": {
          "$ref": "#/$defs/DynamicString"
        },
        "text": {
          "$ref": "#/$defs/DynamicString"
        },
        "tone": {
          "type": "string",
          "enum": [
            "info",
            "caution",
            "success"
          ]
        }
      },
      "required": [
        "id",
        "component",
        "text",
        "tone"
      ],
      "additionalProperties": false
    },
    "Badge": {
      "type": "object",
      "description": "Small status label.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Badge"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "info",
            "success",
            "caution"
          ],
          "default": "neutral"
        }
      },
      "required": [
        "id",
        "component",
        "label"
      ],
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "description": "Single number with label. null renders as unavailable, never as 0.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Metric"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "value": {
          "$ref": "#/$defs/NullableDynamicNumber"
        },
        "unit": {
          "type": "string",
          "maxLength": 4096
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "format": {
          "type": "string",
          "enum": [
            "number",
            "currency",
            "percent"
          ],
          "default": "number"
        }
      },
      "required": [
        "id",
        "component",
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "description": "Progress bar; missing/null total or current renders indeterminate.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Progress"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "current": {
          "$ref": "#/$defs/NullableDynamicNumber"
        },
        "total": {
          "$ref": "#/$defs/NullableDynamicNumber"
        }
      },
      "required": [
        "id",
        "component",
        "current"
      ],
      "additionalProperties": false
    },
    "KeyValueList": {
      "type": "object",
      "description": "Definition list of label/value pairs.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "KeyValueList"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "items": {
          "description": "Up to 32 label/value pairs (literal or bound).",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 4096
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 32,
                    "description": "Evidence links; every id must resolve in /meta/sources."
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            {
              "$ref": "#/$defs/DataBinding"
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "items"
      ],
      "additionalProperties": false
    },
    "Image": {
      "type": "object",
      "description": "Static image from an https URL; alt text is required.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Image"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "src": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://",
          "description": "https:// only; no credentials, no control characters."
        },
        "alt": {
          "type": "string",
          "maxLength": 4096
        },
        "caption": {
          "type": "string",
          "maxLength": 4096
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 64,
          "maximum": 600
        }
      },
      "required": [
        "id",
        "component",
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "DataTable": {
      "type": "object",
      "description": "Sortable/filterable/paged table (local interaction only). Null never sorts as 0.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "DataTable"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
                "description": "Row key this column reads. A `sources` column reads a string[] of source ids under THIS key (REVIEW-C0 E11)."
              },
              "label": {
                "type": "string",
                "maxLength": 4096
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "number",
                  "currency",
                  "percent",
                  "date",
                  "sources"
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 4096
              },
              "precision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "description": "Up to 100 row objects whose keys are declared column keys; cells are finite scalars. For a column of type `sources` the cell under that column's key is a string[] of source ids, each resolving in /meta/sources (dangling ids reject).",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              },
              "maxItems": 100
            },
            {
              "$ref": "#/$defs/DataBinding"
            }
          ]
        },
        "pageSize": {
          "type": "integer",
          "minimum": 5,
          "maximum": 50
        }
      },
      "required": [
        "id",
        "component",
        "columns",
        "rows"
      ],
      "additionalProperties": false
    },
    "Chart": {
      "type": "object",
      "description": "uPlot chart. bar: zero baseline; line: null splits the line; scatter: no fitted line; histogram: bins supplied, never computed.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Chart"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "kind": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "histogram",
            "scatter"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "xLabel": {
          "type": "string",
          "maxLength": 4096
        },
        "yLabel": {
          "type": "string",
          "maxLength": 4096
        },
        "unit": {
          "type": "string",
          "maxLength": 4096
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4096
              },
              "data": {
                "description": "Up to 512 points shaped per kind: see $defs/ChartPoint_<kind>.",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 512
                  },
                  {
                    "$ref": "#/$defs/DataBinding"
                  }
                ]
              }
            },
            "required": [
              "label",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "caveat": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "component",
        "kind",
        "series"
      ],
      "additionalProperties": false
    },
    "Timeline": {
      "type": "object",
      "description": "Ordered list of dated/status steps.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "Timeline"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        },
        "items": {
          "description": "Up to 30 items (literal or bound).",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "done",
                      "active",
                      "pending"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 32,
                    "description": "Evidence links; every id must resolve in /meta/sources."
                  }
                },
                "required": [
                  "label"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            },
            {
              "$ref": "#/$defs/DataBinding"
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "items"
      ],
      "additionalProperties": false
    },
    "SourceList": {
      "type": "object",
      "description": "Renders the referenced sources (sourceIds; default: all of /meta/sources) with labels, links and notes.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "component": {
          "const": "SourceList"
        },
        "accessibility": {
          "$ref": "#/$defs/Accessibility"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 32,
          "description": "Evidence links; every id must resolve in /meta/sources."
        },
        "title": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "component"
      ],
      "additionalProperties": false
    }
  },
  "functions": {},
  "$defs": {
    "ComponentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "description": "Component id; unique within the surface. Never __proto__/constructor/prototype (REVIEW-C0 E3)."
    },
    "Accessibility": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "DataBinding": {
      "type": "object",
      "description": "JSON Pointer into the surface dataModel; must start with /data/ or /meta/ and resolve.",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(data|meta)/",
          "maxLength": 1024
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "DynamicString": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "DynamicNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "NullableDynamicNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "DynamicArray": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "$ref": "#/$defs/DataBinding"
        }
      ]
    },
    "ChartPoint_bar": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "ChartPoint_line": {
      "type": "object",
      "properties": {
        "x": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "number"
            }
          ]
        },
        "y": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "description": "line point: x is a finite number or an ISO-8601 string (datetime.fromisoformat, trailing Z allowed); one series never mixes the two."
    },
    "ChartPoint_scatter": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "ChartPoint_histogram": {
      "type": "object",
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "low",
        "high",
        "count"
      ],
      "additionalProperties": false,
      "description": "histogram bin: low < high; bins sorted ascending and non-overlapping."
    },
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Card"
        },
        {
          "$ref": "#/components/Stack"
        },
        {
          "$ref": "#/components/Grid"
        },
        {
          "$ref": "#/components/Divider"
        },
        {
          "$ref": "#/components/Tabs"
        },
        {
          "$ref": "#/components/Accordion"
        },
        {
          "$ref": "#/components/Heading"
        },
        {
          "$ref": "#/components/Text"
        },
        {
          "$ref": "#/components/Callout"
        },
        {
          "$ref": "#/components/Badge"
        },
        {
          "$ref": "#/components/Metric"
        },
        {
          "$ref": "#/components/Progress"
        },
        {
          "$ref": "#/components/KeyValueList"
        },
        {
          "$ref": "#/components/Image"
        },
        {
          "$ref": "#/components/DataTable"
        },
        {
          "$ref": "#/components/Chart"
        },
        {
          "$ref": "#/components/Timeline"
        },
        {
          "$ref": "#/components/SourceList"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": false
  }
}
